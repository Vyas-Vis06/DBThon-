# Copy to `.env` and edit. `.env` is git-ignored: NEVER commit real values.
# `python scripts/dev.py` needs none of this: it starts an embedded PostgreSQL and wires itself up.

APP_ENV=development                # development | test | production

# Runtime connection. Uses the least-privilege role `ze_app` (not the owner, not a superuser).
DATABASE_URL=postgresql+psycopg://ze_app:CHANGE_ME@localhost:5432/zeroentry

# Migration / seeding connection. Must be the schema owner (or a superuser). Falls back to DATABASE_URL.
MIGRATION_DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/zeroentry

# Password that `python scripts/db.py bootstrap` assigns to the `ze_app` login role.
APP_DB_PASSWORD=CHANGE_ME

SESSION_TTL_MINUTES=60
LOGIN_MAX_FAILURES=5               # failed logins before the account is locked
LOGIN_LOCK_MINUTES=15
COOKIE_SECURE=false                # must be true when APP_ENV=production (HTTPS only)
LOG_LEVEL=INFO

# Password for the demo accounts created by `python scripts/seed.py`. Development only: the seeder
# refuses to run when APP_ENV=production and refuses this placeholder value.
SEED_USER_PASSWORD=CHANGE_ME
